<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Account slots 0..3 (UserConfig.MAX_ACCOUNT_COUNT); rules do not support globs. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="impulse_session.xml" />
        <exclude domain="sharedpref" path="impulse_session1.xml" />
        <exclude domain="sharedpref" path="impulse_session2.xml" />
        <exclude domain="sharedpref" path="impulse_session3.xml" />
        <exclude domain="sharedpref" path="impulse_proxy.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="impulse_session.xml" />
        <exclude domain="sharedpref" path="impulse_session1.xml" />
        <exclude domain="sharedpref" path="impulse_session2.xml" />
        <exclude domain="sharedpref" path="impulse_session3.xml" />
        <exclude domain="sharedpref" path="impulse_proxy.xml" />
    </device-transfer>
</data-extraction-rules>
